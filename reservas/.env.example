# Copy to .env on srv and fill in real values. Never commit .env.

# Your centre student id (lowercase alphanumeric). Zone = <STUDENT_ID>.despliegue.internal
STUDENT_ID=alumno01
BASE_DOMAIN=alumno01.despliegue.internal

DB_PASSWORD=change_this_password
DB_ROOT_PASSWORD=change_this_root_password

# Long random string shared by auth (issuer) and app (verifier) for HS256.
JWT_SECRET=change_this_to_a_long_random_secret

# Must match your DNS name for the issuer (lab u01-03 / u01-05).
JWT_ISSUER=https://auth.alumno01.despliegue.internal
JWT_AUDIENCE=reservas-api
TOKEN_TTL_SECONDS=3600
